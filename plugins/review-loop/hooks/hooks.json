{
  "description": "Review loop stop hook: runs the selected reviewer, then returns findings to the main Claude session",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
            "timeout": 600,
            "statusMessage": "Review loop: running reviewer..."
          }
        ]
      }
    ]
  }
}
